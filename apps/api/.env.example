# Xero Custom Connection
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT session signing (generate with: openssl rand -hex 32)
JWT_SECRET=

# Secret for /auth/connect endpoint (generate with: openssl rand -hex 16)
CONNECT_SECRET=

# Toggl Track (optional). Personal API token from Toggl profile settings;
# without it time tracking reports itself unconfigured. Workspace defaults to
# the token owner's default workspace; timezone is the zone entries are
# bucketed into by local day.
TOGGL_API_TOKEN=
TOGGL_WORKSPACE_ID=
TOGGL_TIMEZONE=Europe/London

# Remote MCP endpoint for claude.ai (optional). The endpoint is
# https://<api>/mcp/<MCP_SECRET>; the path is the only access control, so use
# a long random value (openssl rand -hex 24) that is NOT the CONNECT_SECRET.
# Unset = endpoint off.
MCP_SECRET=

# CORS - Lovable frontend URL
FRONTEND_URL=http://localhost:5173

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
